 "structures": [
  {
   "id": "ce-nest-pas",
   "regex": "(?i)\\b(?:ce n['’]est|c['’]est) pas (?:juste |seulement |que |qu['’]une? )?[^.!?\\n]{2,60}[,.] (?:c['’]est|mais)\\b",
   "name": "« Ce n'est pas X, c'est Y »",
   "fix": "Dis la seule chose que tu veux dire. Supprime la moitié qui prépare le terrain."
  },
  {
   "id": "pas-une-question",
   "regex": "(?i)\\bce n['’]est pas une question de [^.!?\\n]{2,60}[.!,] c['’]est une question de\\b",
   "name": "« Ce n'est pas une question de X, c'est une question de Y »",
   "fix": "Commence par Y. Le retournement est la signature."
  },
  {
   "id": "non-seulement",
   "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également|en plus)\\b",
   "name": "« Non seulement X, mais aussi Y »",
   "fix": "Deux phrases, ou garde la plus forte."
  },
  {
   "id": "la-question-revelee",
   "regex": "(?im)^\\s*(?:le résultat|la suite|le pire|le meilleur|le twist|le hic|la clé|le secret|la raison|la vérité)\\s*\\?\\s*$",
   "name": "Ligne-question rhétorique (« Le résultat ? »)",
   "fix": "Donne la réponse dans la phrase au lieu de mettre en scène la révélation."
  },
  {
   "id": "voici-ce-que",
   "regex": "(?i)\\bvoici ce que (?:j['’]ai|nous avons|on a) appris\\b",
   "name": "« Voici ce que j'ai appris »",
   "fix": "Dis la leçon. Saute l'annonce."
  },
  {
   "id": "triade",
   "regex": "(?i)\\b(?:[\\w'’-]+ )?[\\w'’-]+, (?:[\\w'’-]+ )?[\\w'’-]+ et (?:[\\w'’-]+ )?[\\w'’-]+\\.",
   "name": "Triade (trois éléments, une virgule, un « et »)",
   "fix": "Deux éléments ou quatre. Trois, c'est le rythme par défaut de la machine."
  },
  {
   "id": "emoji-fusee",
   "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
   "name": "Emoji fusée, feu, ampoule, étincelles ou cible",
   "fix": "Un emoji au plus, et pas l'un de ces cinq."
  },
  {
   "id": "mur-hashtags",
   "regex": "(?:#\\w+[ \\t]*){5,}",
   "name": "Mur de hashtags (5 ou plus)",
   "fix": "Trois hashtags précis, ou aucun. Instagram plafonne à cinq depuis décembre 2025."
  },
  {
   "id": "en-tant-qu-ia",
   "regex": "(?i)\\ben tant qu['’](?:ia|intelligence artificielle|assistant|modèle de langage)\\b",
   "name": "L'IA qui parle d'elle",
   "fix": "Supprime la phrase."
  },
  {
   "id": "en-resume",
   "regex": "(?im)^\\s*(?:en résumé|pour résumer|en conclusion|pour conclure|en somme)\\b",
   "name": "Ouverture de conclusion de dissertation",
   "fix": "Un post n'a pas besoin d'un paragraphe de conclusion."
  },
  {
   "id": "appat-avis",
   "regex": "(?i)\\b(?:vous êtes d['’]accord|t['’]es d['’]accord|qu['’]en pensez-vous|qu['’]en penses-tu|qui d['’]autre|j['’]ai tort)\\s*\\?\\s*$",
   "name": "Appât à commentaires réflexe",
   "fix": "Pose une question que toi seul peux poser, sur ce qui est juste au-dessus."
  },
  {
   "id": "stop-scroll",
   "regex": "(?im)^\\s*(?:arrête|arrêtez|stop|attends)[,.]?\\s+(?:de\\s+)?(?:scroller|défiler)|^\\s*ne scrolle pas\\b",
   "name": "Ouverture « Arrête de scroller »",
   "fix": "L'arrêt du pouce doit venir de l'affirmation elle-même. Demander l'attention trahit qu'on ne l'a pas gagnée."
  },
  {
   "id": "dans-cette-video",
   "regex": "(?i)\\b(?:dans (?:cette|la) vidéo(?: d['’]aujourd['’]hui| du jour)?|dans ce (?:reel|post)|aujourd['’]hui,? je vais (?:te|vous) montrer|je vais (?:te|vous) (?:montrer|apprendre) comment|on va voir ensemble)\\b",
   "name": "Préambule vidéo (« Dans cette vidéo, je vais te montrer »)",
   "fix": "Supprime-le et commence par la réponse. Les deux premières secondes décident du reel entier."
  },
  {
   "id": "puces-emoji",
   "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
   "name": "Liste à puces en emoji",
   "fix": "Un tiret ou un retour à la ligne. Les puces emoji sont ce qui fait le plus modèle tout fait dans une légende."
  },
  {
   "id": "majuscules",
   "regex": "\\b[A-ZÀ-ÖØ-Ý]{3,}\\b(?:\\s+\\b[A-ZÀ-ÖØ-Ý]{3,}\\b){2,}",
   "name": "Trois mots en majuscules d'affilée",
   "fix": "Les majuscules montent le volume, elles ne surlignent pas. Un mot, au plus."
  },
  {
   "id": "appat-abonnement",
   "regex": "(?i)\\b(?:abonne-toi pour|abonnez-vous pour|identifie (?:quelqu['’]un|un ami|une amie|un pote)|double[- ]tape si|partage (?:ce post |cette vidéo )?(?:à|avec) quelqu['’]un qui|commente si)\\b",
   "name": "Appât à abonnement ou à identification",
   "fix": "Demande la seule action que ce post mérite. La demande générique apprend à l'audience à ignorer toutes les demandes."
  },
  {
   "id": "et-si-je-te-disais",
   "regex": "(?i)\\b(?:et )?si je (?:te|vous) disais que\\b",
   "name": "« Et si je te disais que »",
   "fix": "Dis-le. La devinette retarde l'information que le spectateur est venu chercher."
  },
  {
   "id": "nhesite-pas",
   "regex": "(?i)\\bn['’]h[ée]sit(?:e|ez) pas à\\b",
   "name": "« N'hésite pas à »",
   "fix": "Demande directement : « Écris-moi » plutôt que « N'hésite pas à m'écrire »."
  },
  {
   "id": "que-tu-sois",
   "regex": "(?i)\\bque (?:tu sois|vous soyez) [^.!?\\n]{2,40} ou\\b",
   "name": "« Que tu sois débutant ou expert »",
   "fix": "Choisis à qui tu parles. Parler à tout le monde, c'est ne parler à personne."
  },
  {
   "id": "dans-un-monde-ou",
   "regex": "(?im)^\\s*dans un monde (?:où|qui)\\b",
   "name": "Ouverture « Dans un monde où »",
   "fix": "Commence par le fait précis qui t'a donné envie d'écrire."
  },
  {
   "id": "deux-points-revelation",
   "regex": "(?i)\\b(?:la réponse|le secret|la vérité|la raison) (?:est )?simple\\s*:",
   "name": "« La réponse est simple : »",
   "fix": "Donne la réponse sans l'annoncer."
  }
 ]
